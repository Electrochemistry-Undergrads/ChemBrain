# ChemBrain configuration — PLACEHOLDERS ONLY. Never commit real values.
#
# Local development: copy the server values into `.dev.vars` (git-ignored), used by `wrangler pages dev`.
# Production / preview: set secrets in Cloudflare → Workers & Pages → chembrain → Settings →
#   Variables and Secrets (choose Production or Preview, type "Secret"), or with
#   `wrangler pages secret put NAME --project-name chembrain`.
# Non-secret settings live in wrangler.toml [vars].

# --- Secrets (server-side only) ---
# Meta Model API key from https://dev.meta.ai (starts with LLM_).
MODEL_API_KEY=
# 32 random bytes, base64. Encrypts stored publisher credentials. Generate: openssl rand -base64 32
# Rotating it makes previously saved publisher credentials unreadable (users re-enter them).
CREDENTIALS_KEY=
# Optional: contact address for Crossref's polite pool (sent only to Crossref, never shown on the site).
CONTACT_EMAIL=

# --- Non-secret settings (defaults in wrangler.toml) ---
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_REASONING_EFFORT=medium
META_JOB_TOKEN_BUDGET=1500000
META_DAILY_TOKEN_BUDGET=3000000
ALLOW_GUESTS=true
ALLOW_SIGNUP=true
RETAIN_ORIGINALS=false

# --- Publisher credentials are NOT server configuration ---
# Each researcher enters their own Elsevier / Wiley / Springer Nature credentials in the app
# (Publisher connections). They are encrypted per user with CREDENTIALS_KEY.
#
# --- Deployment credential (separate from runtime secrets) ---
# For CLI deploys/migrations only: put CLOUDFLARE_API_TOKEN in `.deploy.env` (git-ignored).
