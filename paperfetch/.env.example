# Copy to .env and fill in what you have. Every key is optional; each unlocks more papers.

# Your email: used as the polite-pool contact for OpenAlex/Crossref/NCBI and required by Unpaywall.
CONTACT_EMAIL=

# Free at https://openalex.org/users — cached PDFs and GROBID XML, gets around publisher bot walls.
OPENALEX_API_KEY=

# Free at https://dev.elsevier.com — ScienceDirect full-text XML. Entitled when you run on the UT
# network or VPN. For off-campus use, ask UT Libraries for an institutional token.
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=

# Free Wiley TDM token: log in at onlinelibrary.wiley.com, open "Text and Data Mining", accept the
# terms. Entitled from the UT network/VPN.
WILEY_TDM_TOKEN=

# Free at https://dev.springernature.com — open-access Springer/Nature articles as JATS XML.
SPRINGER_API_KEY=

# Free at https://core.ac.uk/services/api — repository copies (accepted manuscripts, theses).
CORE_API_KEY=

# Optional: higher rate limits.
S2_API_KEY=
NCBI_API_KEY=

# Optional: Zotero data directory (auto-detected at ~/Zotero).
# ZOTERO_DIR=/Users/you/Zotero
# Library proxy prefix used for the links in download_queue.html.
# LIBRARY_PROXY_PREFIX=https://login.ezproxy.lib.utexas.edu/login?url=
